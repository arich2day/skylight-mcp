{
  "mcpServers": {
    "skylight": {
      "command": "bash",
      "args": [
        "-lc",
        "[ -d node_modules ] || npm ci; [ -f dist/index.js ] || npm run build; exec node dist/index.js"
      ],
      "env": {
        "SKYLIGHT_TOKEN": "${SKYLIGHT_TOKEN}",
        "SKYLIGHT_AUTH_TYPE": "${SKYLIGHT_AUTH_TYPE:-bearer}",
        "SKYLIGHT_FRAME_ID": "${SKYLIGHT_FRAME_ID}",
        "SKYLIGHT_TIMEZONE": "${SKYLIGHT_TIMEZONE:-America/New_York}"
      }
    }
  }
}
